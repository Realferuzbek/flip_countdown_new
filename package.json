{
  "name": "flip-countdown",
  "version": "1.0.3",
  "description": "Local-only flip countdown timer",
  "author": "Feruzbek",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win nsis",
    "build:mac": "electron-builder --mac dmg",
    "build:linux": "electron-builder --linux AppImage",
    "web:serve": "http-server -a 127.0.0.1 -p 5173 .",
    "web:open": "start \"\" \"http://127.0.0.1:5173/web/index.html\""
  },
  "devDependencies": {
    "electron": "30.0.0",
    "electron-builder": "^26.0.12",
    "http-server": "^14.1.1"
  },
  "engines": {
    "node": ">=18"
  },
  "build": {
    "appId": "com.feruzbek.flipcountdown",
    "productName": "Flip Countdown",
    "compression": "maximum",
    "asar": true,
    "electronLanguages": ["en-US"],
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*.html",
      "renderer/**/*.js",
      "renderer/**/*.css",
      "assets/background.jpg",
      "assets/alarm.mp3",
      "package.json"
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": ["nsis"],
      "icon": "assets/icon.ico",
      "//codeSigning": "Set CS_PFX_FILE and CS_PFX_PASSWORD env vars or provide certificateFile/certificatePassword below when ready.",
      "//certificateFile": "path/to/cert.pfx",
      "//certificatePassword": "${env.CS_PFX_PASSWORD}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.utilities",
      "icon": "assets/icon.icns",
      "//hardenedRuntime": "Set to true when enabling notarization.",
      "//entitlements": "build/entitlements.mac.plist",
      "//entitlementsInherit": "build/entitlements.mac.plist",
      "//appleId": "${env.APPLE_ID}",
      "//appleIdPassword": "${env.APPLE_APP_SPECIFIC_PASSWORD}",
      "//teamId": "${env.APPLE_TEAM_ID}"
    },
    "dmg": {
      "backgroundColor": "#000000"
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Utility",
      "icon": "assets/icon.png"
    },
    "//afterSign": "Hook notarization script here when enabling macOS/Windows signing (e.g., ./scripts/notarize.js).",
    "publish": "never"
  }
}
